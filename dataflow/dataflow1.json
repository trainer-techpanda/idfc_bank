{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DimAccountParquet",
						"type": "DatasetReference"
					},
					"name": "DimAccountsource"
				},
				{
					"dataset": {
						"referenceName": "DimBranchParquet",
						"type": "DatasetReference"
					},
					"name": "DimBranchsource"
				},
				{
					"dataset": {
						"referenceName": "DimCustomerParquet",
						"type": "DatasetReference"
					},
					"name": "DimCustomersource"
				},
				{
					"dataset": {
						"referenceName": "DimDateParquet",
						"type": "DatasetReference"
					},
					"name": "DimDatesource"
				},
				{
					"dataset": {
						"referenceName": "FactTransactionParquet",
						"type": "DatasetReference"
					},
					"name": "FactTransactionsrc"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "adls_ls",
						"type": "LinkedServiceReference"
					},
					"name": "sink1"
				},
				{
					"linkedService": {
						"referenceName": "adls_ls",
						"type": "LinkedServiceReference"
					},
					"name": "sink2"
				},
				{
					"linkedService": {
						"referenceName": "adls_ls",
						"type": "LinkedServiceReference"
					},
					"name": "sink3"
				},
				{
					"linkedService": {
						"referenceName": "adls_ls",
						"type": "LinkedServiceReference"
					},
					"name": "sink4"
				},
				{
					"linkedService": {
						"referenceName": "adls_ls",
						"type": "LinkedServiceReference"
					},
					"name": "sink5"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "derivedColumn4"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "alterRow2"
				},
				{
					"name": "alterRow3"
				},
				{
					"name": "alterRow4"
				},
				{
					"name": "alterRow5"
				}
			],
			"scriptLines": [
				"source(output(",
				"          account_id as long,",
				"          customer_id as integer,",
				"          account_type as string,",
				"          account_status as string,",
				"          opening_date as date,",
				"          closing_date as date,",
				"          branch_id as integer,",
				"          balance as decimal(18,2),",
				"          updated_at as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> DimAccountsource",
				"source(output(",
				"          branch_id as integer,",
				"          branch_name as string,",
				"          city as string,",
				"          state as string,",
				"          country as string,",
				"          branch_type as string,",
				"          updated_at as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> DimBranchsource",
				"source(output(",
				"          customer_id as integer,",
				"          customer_name as string,",
				"          email as string,",
				"          phone as string,",
				"          city as string,",
				"          state as string,",
				"          country as string,",
				"          customer_type as string,",
				"          created_date as date,",
				"          updated_at as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> DimCustomersource",
				"source(output(",
				"          date_key as integer,",
				"          date as date,",
				"          day as integer,",
				"          month as integer,",
				"          year as integer,",
				"          quarter as integer,",
				"          weekday as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> DimDatesource",
				"source(output(",
				"          transaction_id as long,",
				"          account_id as long,",
				"          customer_id as integer,",
				"          branch_id as integer,",
				"          date_key as integer,",
				"          transaction_type as string,",
				"          transaction_amount as decimal(18,2),",
				"          transaction_status as string,",
				"          payment_mode as string,",
				"          transaction_timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> FactTransactionsrc",
				"DimAccountsource derive(balance = coalesce(balance,0)) ~> derivedColumn1",
				"FactTransactionsrc derive(transaction_amount = coalesce(transaction_amount,0)) ~> derivedColumn2",
				"derivedColumn1 derive(account_status = coalesce(account_status,'N/A')) ~> derivedColumn3",
				"derivedColumn3 derive(account_type = coalesce(account_type,'N/A')) ~> derivedColumn4",
				"derivedColumn4 alterRow(upsertIf(1==1)) ~> alterRow1",
				"DimBranchsource alterRow(upsertIf(0==0)) ~> alterRow2",
				"DimCustomersource alterRow(upsertIf(1==1)) ~> alterRow3",
				"DimDatesource alterRow(upsertIf(1>0)) ~> alterRow4",
				"derivedColumn2 alterRow(upsertIf(1>0)) ~> alterRow5",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'DimAccount',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:['account_id'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1) ~> sink1",
				"alterRow2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'DimBranch',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:['branch_id'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 2) ~> sink2",
				"alterRow3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'DimCustomer',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:['customer_id'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 3) ~> sink3",
				"alterRow4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'DimDate',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:['date_key'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1) ~> sink4",
				"alterRow5 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'FactTransaction',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:['transaction_id'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 5) ~> sink5"
			]
		}
	}
}